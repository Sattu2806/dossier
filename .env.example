# Copy to .env (never commit .env):   cp .env.example .env

# --- Tracing (useful from day one) -------------------------------------------
# Free account: https://smith.langchain.com  → Settings → API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dossier

# --- LLM ---------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default in src/dossier/llm.py)
# DOSSIER_MODEL=gemini-3.5-flash-lite

# --- Web search — free key: https://tavily.com -------------------------------
TAVILY_API_KEY=

# --- Accounts (optional) -----------------------------------------------------
# With these set, people sign in with Clerk and each gets their own history and
# daily budget. Without them the app runs on API keys alone, which is what
# self-hosting and local development use.
#
# The API only ever needs the PUBLISHABLE key: it verifies sessions against
# Clerk's public JWKS, so Clerk's secret never has to reach the backend.
CLERK_PUBLISHABLE_KEY=
# CLERK_JWKS_URL=            # only for a custom or proxied Clerk domain
DOSSIER_SIGNUP_TOKEN_LIMIT=60000
DOSSIER_GLOBAL_DAILY_TOKEN_LIMIT=0    # 0 = no instance-wide ceiling
