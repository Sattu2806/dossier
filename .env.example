# Copy to .env (never commit .env):   cp .env.example .env

# --- Tracing (useful from day one) -------------------------------------------
# Free account: https://smith.langchain.com  → Settings → API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dossier

# --- LLM ---------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
